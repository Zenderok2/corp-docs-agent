# Local values. In hosted mode use HTTPS and generate separate strong secrets.
APP_ENV=local
APP_STORAGE_ROOT=./runtime
STAFF_ACCESS_CODE=
QUALITY_ACCESS_CODE=
SESSION_SECRET=
PUBLIC_ORIGIN=
BUILD_SHA=local

# Native backend. Compose sets the internal service URLs.
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=corp-chat
EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
EMBEDDING_MODEL=corp-embed
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE_VERSION=qwen3-embedding-0.6b-q8-v1
CHROMA_BASE_URL=http://127.0.0.1:8001
RETRIEVAL_MODE=lexical
ANSWER_TIMEOUT_SECONDS=150
MAX_PENDING_QUESTIONS=6
MAX_UPLOAD_MB=25

# Compose ingress. Publish ports only for the hosted demonstration.
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
CHAT_THREADS=2
EMBEDDING_THREADS=2
