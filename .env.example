# Projected configuration; the new application does not read this file yet.
# Copy to .env during implementation; never commit real credentials.
APP_ENV=local
APP_STORAGE_ROOT=./runtime
DATABASE_PATH=./runtime/app.sqlite3
UPLOADS_DIR=./runtime/uploads

# Team-controlled llama.cpp server; loopback for native Windows.
LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=corp-chat

# First end-to-end run uses FTS5. Hybrid requires local embeddings and Chroma.
RETRIEVAL_MODE=lexical
EMBEDDING_PROVIDER=llama_cpp
EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
EMBEDDING_DOCUMENT_MODEL=corp-embed
EMBEDDING_QUERY_MODEL=corp-embed
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE_VERSION=qwen3-embedding-0.6b-q8-v1

# Local development values. Compose backend uses CHROMA_HOST=chroma.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=corp_docs

# Public frontend setting only; never use VITE_ for any secret.
VITE_API_BASE_URL=/api/v1

# Initial design budgets; to be calibrated during implementation.
MAX_UPLOAD_MB=25
MAX_AGENT_SEARCHES=3
MAX_LLM_CALLS=4
ANSWER_TIMEOUT_SECONDS=45
MAX_ACTIVE_INGESTION_JOBS=1
